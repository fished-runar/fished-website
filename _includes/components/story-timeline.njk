<section class="section" style="background: var(--blue-light); padding-top: 56px; padding-bottom: 56px">
  <div class="container">
    <div style="text-align: center" class="reveal">
      <p class="section-label">Our journey</p>
      <h2 class="section-title dark">Our Story</h2>
    </div>
    <div class="milestone-list reveal" style="margin-top: 56px; grid-template-columns: repeat({{ timeline.length }}, 1fr)">
      {% for item in timeline %}
      <div class="milestone-item">
        <div class="milestone-marker">
          <span class="milestone-dot"></span>
          <span class="milestone-date">{{ item.year }}</span>
          {% if not loop.last %}<span class="milestone-line"></span>{% endif %}
        </div>
        <h3 class="milestone-title">{{ item.title }}</h3>
        <p class="milestone-text">{{ item.text }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

